rules_version = '2';
service firebase.storage {
  match /b/{bucket}/o {
    match /gyms/{gymId}/{allPaths=**} {
      allow read, write: if request.auth != null && request.auth.token.firebase.appcheck != null && (
        firestore.get(/databases/(default)/documents/users/$(request.auth.uid)).data.role == 'super_admin' ||
        (
          firestore.get(/databases/(default)/documents/users/$(request.auth.uid)).data.gymId == gymId &&
          (!('accountStatus' in firestore.get(/databases/(default)/documents/users/$(request.auth.uid)).data) ||
           firestore.get(/databases/(default)/documents/users/$(request.auth.uid)).data.accountStatus == 'Active')
        )
      );
    }
  }
}
