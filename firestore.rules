rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // Helper functions
    function getUserData() {
      return get(/databases/$(database)/documents/users/$(request.auth.uid)).data;
    }

    function isActive() {
      return request.auth != null && (
        !exists(/databases/$(database)/documents/users/$(request.auth.uid)) ||
        !('accountStatus' in getUserData()) ||
        getUserData().accountStatus == 'Active'
      );
    }

    // Checking if user is super admin - also requires being active
    function isSuperAdmin() {
      return isActive() && getUserData().role == 'super_admin';
    }

    function hasGymAccess(resourceData) {
      return isActive() && (
        isSuperAdmin() || 
        (getUserData().gymId == resourceData.gymId && (
          getUserData().role == 'gym_owner' || 
          getUserData().role == 'branch_manager' || 
          getUserData().branchId == resourceData.branchId
        ))
      );
    }

    function canWriteGymData(resourceData) {
      return isActive() && (
        isSuperAdmin() || 
        (getUserData().gymId == resourceData.gymId && (
          getUserData().role == 'gym_owner' || 
          getUserData().role == 'branch_manager' || 
          getUserData().branchId == resourceData.branchId
        ))
      );
    }

    function canCreateGymData(resourceData) {
      return isActive() && (
        isSuperAdmin() || 
        (getUserData().gymId == resourceData.gymId && (
          getUserData().role == 'gym_owner' || 
          getUserData().role == 'branch_manager' || 
          getUserData().branchId == resourceData.branchId
        ))
      );
    }

    function canUpdateGymData(currentData, newData) {
      return isActive() && (
        isSuperAdmin() || 
        (
          currentData.gymId == getUserData().gymId &&
          (getUserData().role == 'gym_owner' || getUserData().role == 'branch_manager' || getUserData().branchId == currentData.branchId) &&
          newData.gymId == currentData.gymId
        )
      );
    }



    // Gyms rules
    match /gyms/{gymId} {
      allow create: if isActive();
      allow read: if isActive() && (isSuperAdmin() || getUserData().gymId == gymId);
      allow write: if isActive() && (isSuperAdmin() || (getUserData().gymId == gymId && (getUserData().role == 'gym_owner' || getUserData().role == 'branch_manager')));
    }

    // Branches rules
    match /branches/{branchId} {
      allow read: if isActive() && (
        isSuperAdmin() || 
        (getUserData().gymId == resource.data.gymId && (
          getUserData().role == 'gym_owner' || 
          getUserData().role == 'branch_manager' || 
          getUserData().branchId == branchId
        ))
      );
      allow write: if isActive() && (
        isSuperAdmin() || 
        ((getUserData().role == 'gym_owner' || getUserData().role == 'branch_manager') && request.resource.data.gymId == getUserData().gymId)
      );
    }

    // Users rules
    match /users/{userId} {
      allow read: if request.auth != null && (
        request.auth.uid == userId || 
        isSuperAdmin() || 
        (isActive() && getUserData().gymId == resource.data.gymId)
      );
      
      allow create: if isActive() && 
        request.resource.data.role != 'super_admin' && (
          // Case 1: Public registration - user can only self-register as gym_owner
          (request.auth.uid == userId && request.resource.data.role == 'gym_owner') ||
          // Case 2: Employee creation by an owner or manager or super admin
          (request.auth.uid != userId && (
            isSuperAdmin() || (
              (getUserData().role == 'gym_owner' || getUserData().role == 'branch_manager') && 
              request.resource.data.gymId == getUserData().gymId &&
              (request.resource.data.role == 'gym_owner' ||
               request.resource.data.role == 'branch_manager' || 
               request.resource.data.role == 'trainer' || 
               request.resource.data.role == 'staff')
            )
          ))
        );

      allow update: if isActive() && (
        request.auth.uid == userId || 
        isSuperAdmin() || 
        ((getUserData().role == 'gym_owner' || getUserData().role == 'branch_manager') && resource.data.gymId == getUserData().gymId)
      ) && (
        // Check if role is changing
        request.resource.data.role == resource.data.role || (
          // If role is changing, it is only allowed under strict authorization:
          request.auth.uid != userId && 
          request.resource.data.role != 'super_admin' && (
            isSuperAdmin() || (
              (getUserData().role == 'gym_owner' || getUserData().role == 'branch_manager') && 
              resource.data.gymId == getUserData().gymId &&
              (request.resource.data.role == 'gym_owner' ||
               request.resource.data.role == 'branch_manager' || 
               request.resource.data.role == 'trainer' || 
               request.resource.data.role == 'staff')
            )
          )
        )
      ) && (
        // gymId, branchId, and accountStatus updates are restricted to super_admin or owner/manager
        isSuperAdmin() || 
        ((getUserData().role == 'gym_owner' || getUserData().role == 'branch_manager') && resource.data.gymId == getUserData().gymId) ||
        !request.resource.data.diff(resource.data).affectedKeys().hasAny(['gymId', 'branchId', 'accountStatus'])
      );
      
      allow delete: if isActive() && (isSuperAdmin() || ((getUserData().role == 'gym_owner' || getUserData().role == 'branch_manager') && resource.data.gymId == getUserData().gymId));
    }

    // Audit logs rules
    match /auditLogs/{logId} {
      allow create: if isActive();
      allow read: if isActive() && (
        isSuperAdmin() || 
        (getUserData().gymId == resource.data.gymId && (
          getUserData().role == 'gym_owner' ||
          getUserData().role == 'branch_manager'
        ))
      );
      allow write: if isSuperAdmin();
    }

    // Tenant-isolated collections rules
    match /members/{id} {
      allow read: if hasGymAccess(resource.data);
      allow create: if canCreateGymData(request.resource.data);
      allow update: if canUpdateGymData(resource.data, request.resource.data);
      allow delete: if isActive() && (isSuperAdmin() || ((getUserData().role == 'gym_owner' || getUserData().role == 'branch_manager') && resource.data.gymId == getUserData().gymId));
    }

    match /payments/{id} {
      allow read: if hasGymAccess(resource.data);
      allow create: if canCreateGymData(request.resource.data);
      allow update: if canUpdateGymData(resource.data, request.resource.data);
    }

    match /leads/{id} {
      allow read: if hasGymAccess(resource.data);
      allow create: if canCreateGymData(request.resource.data);
      allow update: if canUpdateGymData(resource.data, request.resource.data);
      allow delete: if isActive() && (isSuperAdmin() || ((getUserData().role == 'gym_owner' || getUserData().role == 'branch_manager') && resource.data.gymId == getUserData().gymId));
    }

    match /trainers/{id} {
      allow read: if hasGymAccess(resource.data);
      allow create: if canCreateGymData(request.resource.data);
      allow update: if canUpdateGymData(resource.data, request.resource.data);
      allow delete: if isActive() && (isSuperAdmin() || ((getUserData().role == 'gym_owner' || getUserData().role == 'branch_manager') && resource.data.gymId == getUserData().gymId));
    }

    match /attendance/{id} {
      allow read: if hasGymAccess(resource.data);
      allow create: if canCreateGymData(request.resource.data);
      allow update: if canUpdateGymData(resource.data, request.resource.data);
    }

    match /expenses/{id} {
      allow read: if hasGymAccess(resource.data);
      allow create: if canCreateGymData(request.resource.data);
      allow update: if canUpdateGymData(resource.data, request.resource.data);
      allow delete: if isActive() && (isSuperAdmin() || ((getUserData().role == 'gym_owner' || getUserData().role == 'branch_manager') && resource.data.gymId == getUserData().gymId));
    }

    match /invoices/{id} {
      allow read: if hasGymAccess(resource.data);
      allow create: if canCreateGymData(request.resource.data);
      allow update: if canUpdateGymData(resource.data, request.resource.data);
    }

    match /collections/{id} {
      allow read: if hasGymAccess(resource.data);
      allow write: if canWriteGymData(request.resource.data);
    }

    match /employees/{id} {
      // READ - role-scoped access
      allow read: if isActive() && (
        isSuperAdmin() ||
        // Gym owner sees all employees in their gym
        (getUserData().role == 'gym_owner' && getUserData().gymId == resource.data.gymId) ||
        // Branch manager sees all employees in the same gym (read-only)
        (getUserData().role == 'branch_manager' && getUserData().gymId == resource.data.gymId) ||
        // Trainer and Staff can only read their own employee record
        (request.auth.uid == id && getUserData().gymId == resource.data.gymId)
      );

      // CREATE - only super_admin, gym_owner, branch_manager or self-creation as owner
      allow create: if isActive() && (
        isSuperAdmin() ||
        (request.auth.uid == id && request.resource.data.role == 'gym_owner') ||
        ((getUserData().role == 'gym_owner' || getUserData().role == 'branch_manager') && request.resource.data.gymId == getUserData().gymId)
      );

      // UPDATE - only super_admin, gym_owner or branch_manager
      // Explicitly prevents salary, role, department modification by anyone else
      allow update: if isActive() && (
        isSuperAdmin() ||
        (
          (getUserData().role == 'gym_owner' || getUserData().role == 'branch_manager') &&
          resource.data.gymId == getUserData().gymId &&
          // Gym owner/manager cannot escalate employee to super_admin
          request.resource.data.role != 'super_admin' &&
          // gymId must not be changed
          request.resource.data.gymId == resource.data.gymId
        )
      );

      // DELETE - only super_admin, gym_owner or branch_manager
      allow delete: if isActive() && (
        isSuperAdmin() ||
        ((getUserData().role == 'gym_owner' || getUserData().role == 'branch_manager') && resource.data.gymId == getUserData().gymId)
      );
    }

    match /employee_attendance/{id} {
      // Branch manager and above can view; trainer/staff see own records only
      allow read: if isActive() && (
        isSuperAdmin() ||
        (getUserData().role == 'gym_owner' && getUserData().gymId == resource.data.gymId) ||
        (getUserData().role == 'branch_manager' && getUserData().gymId == resource.data.gymId) ||
        (resource.data.employeeId == request.auth.uid && getUserData().gymId == resource.data.gymId)
      );
      // Only owner, manager and super_admin may write attendance records
      allow write: if isActive() && (
        isSuperAdmin() ||
        ((getUserData().role == 'gym_owner' || getUserData().role == 'branch_manager') && request.resource.data.gymId == getUserData().gymId)
      );
    }

    match /employee_payroll/{id} {
      // Salary data is confidential — only owner, manager and super_admin may read
      allow read: if isActive() && (
        isSuperAdmin() ||
        ((getUserData().role == 'gym_owner' || getUserData().role == 'branch_manager') && getUserData().gymId == resource.data.gymId)
      );
      // Only owner, manager and super_admin may write payroll records
      allow write: if isActive() && (
        isSuperAdmin() ||
        ((getUserData().role == 'gym_owner' || getUserData().role == 'branch_manager') && request.resource.data.gymId == getUserData().gymId)
      );
    }

    match /employee_performance/{id} {
      // Manager and above can view performance; employee sees own review only
      allow read: if isActive() && (
        isSuperAdmin() ||
        (getUserData().role == 'gym_owner' && getUserData().gymId == resource.data.gymId) ||
        (getUserData().role == 'branch_manager' && getUserData().gymId == resource.data.gymId) ||
        (resource.data.employeeId == request.auth.uid && getUserData().gymId == resource.data.gymId)
      );
      // Only owner, manager and super_admin may write performance reviews
      allow write: if isActive() && (
        isSuperAdmin() ||
        ((getUserData().role == 'gym_owner' || getUserData().role == 'branch_manager') && request.resource.data.gymId == getUserData().gymId)
      );
    }

    match /ptPlans/{id} {
      allow read: if hasGymAccess(resource.data);
      allow create: if canCreateGymData(request.resource.data);
      allow update: if canUpdateGymData(resource.data, request.resource.data);
      allow delete: if isActive() && (isSuperAdmin() || ((getUserData().role == 'gym_owner' || getUserData().role == 'branch_manager') && resource.data.gymId == getUserData().gymId));
    }

    match /ptSessions/{id} {
      allow read: if hasGymAccess(resource.data);
      allow create: if canCreateGymData(request.resource.data);
      allow update: if canUpdateGymData(resource.data, request.resource.data);
      allow delete: if isActive() && (isSuperAdmin() || ((getUserData().role == 'gym_owner' || getUserData().role == 'branch_manager') && resource.data.gymId == getUserData().gymId));
    }

    match /trainerAssignments/{id} {
      allow read: if hasGymAccess(resource.data);
      allow write: if canWriteGymData(request.resource.data);
    }

    match /sessionHistory/{id} {
      allow read: if hasGymAccess(resource.data);
      allow write: if canWriteGymData(request.resource.data);
    }

    match /trainerRevenue/{id} {
      allow read: if hasGymAccess(resource.data);
      allow write: if canWriteGymData(request.resource.data);
    }

    match /memberPTPlans/{id} {
      allow read: if hasGymAccess(resource.data);
      allow write: if canWriteGymData(request.resource.data);
    }

    match /membership_plans/{id} {
      allow read: if isActive() && (isSuperAdmin() || getUserData().gymId == resource.data.gymId);
      allow write: if isActive() && (isSuperAdmin() || ((getUserData().role == 'gym_owner' || getUserData().role == 'branch_manager') && request.resource.data.gymId == getUserData().gymId));
      allow delete: if isActive() && (isSuperAdmin() || ((getUserData().role == 'gym_owner' || getUserData().role == 'branch_manager') && resource.data.gymId == getUserData().gymId));
    }

    match /activity_logs/{id} {
      allow read: if isActive() && (isSuperAdmin() || getUserData().gymId == resource.data.gymId);
      allow write: if isActive() && (isSuperAdmin() || getUserData().gymId == request.resource.data.gymId);
    }

    match /whatsapp_templates/{id} {
      allow read: if isActive() && (isSuperAdmin() || getUserData().gymId == resource.data.gymId);
      allow write: if isActive() && (isSuperAdmin() || ((getUserData().role == 'gym_owner' || getUserData().role == 'branch_manager') && request.resource.data.gymId == getUserData().gymId));
    }

    match /whatsapp_reminders/{id} {
      allow read: if isActive() && (isSuperAdmin() || getUserData().gymId == resource.data.gymId);
      allow write: if isActive() && (isSuperAdmin() || ((getUserData().role == 'gym_owner' || getUserData().role == 'branch_manager') && request.resource.data.gymId == getUserData().gymId));
      allow delete: if isActive() && (isSuperAdmin() || ((getUserData().role == 'gym_owner' || getUserData().role == 'branch_manager') && resource.data.gymId == getUserData().gymId));
    }

    match /body_progress/{id} {
      allow read: if isActive() && (isSuperAdmin() || getUserData().gymId == resource.data.gymId);
      allow write: if isActive() && (isSuperAdmin() || getUserData().gymId == request.resource.data.gymId);
      allow delete: if isActive() && (isSuperAdmin() || ((getUserData().role == 'gym_owner' || getUserData().role == 'branch_manager') && resource.data.gymId == getUserData().gymId));
    }
  }
}
